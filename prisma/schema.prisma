generator client {
  provider = "prisma-client-js"
}

// Connection URL is configured in prisma.config.ts (for CLI) and src/db/index.ts (runtime).
// To switch databases: change provider + update DATABASE_URL in .env + run `npm run db:migrate`
//   sqlite      → file:./offhunter.db
//   mysql       → mysql://user:pass@host:3306/offhunter
//   postgresql  → postgresql://user:pass@host:5432/offhunter
datasource db {
  provider = "sqlite"
}

model GuildConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  channelId String
  keywords  String
  schedule  String   @default("0 8 * * *")
  zipCode   String   @default("60487")
  retailers String?
  maxPrice  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
