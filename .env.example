# Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# Database — pick one and set the URL accordingly
# SQLite (default, no setup needed):
DATABASE_URL="file:./offhunter.db"
# MySQL:
# DATABASE_URL="mysql://user:password@localhost:3306/offhunter"
# PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/offhunter"

# Default zip code for marktguru searches (Germany)
DEFAULT_ZIP=60487
